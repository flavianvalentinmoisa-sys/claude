<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'ro' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ settings.nume_firma | default: shop.name | escape }}</title>
    {%- render 'fonturi' -%}
    <style>
      :root {
        --negru: {{ settings.culoare_negru }};
        --antracit: {{ settings.culoare_antracit }};
        --antracit-card: {{ settings.culoare_antracit_card }};
        --crem: {{ settings.culoare_crem }};
        --crem-card: {{ settings.culoare_crem_card }};
        --crem-linie: {{ settings.culoare_crem_linie }};
        --scris-inchis: {{ settings.culoare_scris_inchis }};
        --scris-inchis-2: {{ settings.culoare_scris_inchis_2 }};
        --scris-deschis: {{ settings.culoare_scris_deschis }};
        --scris-deschis-2: {{ settings.culoare_scris_deschis_2 }};
        --argintiu: {{ settings.culoare_argintiu }};
        --auriu: {{ settings.culoare_auriu }};
        --auriu-inchis: {{ settings.culoare_auriu_inchis }};
        --auriu-transparent: {{ settings.culoare_auriu | color_modify: 'alpha', 0.28 }};
        --auriu-fundal: {{ settings.culoare_auriu | color_modify: 'alpha', 0.12 }};
        --raza-card: {{ settings.raza_carduri }}px;
        --raza-buton: {% if settings.butoane_rotunde %}999px{% else %}{{ settings.raza_carduri }}px{% endif %};
        --latime-logo: {{ settings.latime_logo }}px;
        --font-titluri: 'Cormorant Garamond', Georgia, serif;
        --font-text: 'Source Sans 3', Arial, sans-serif;
      }
    </style>
    {{ 'tema.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="continut">
      {{ content_for_layout }}
    </main>
  </body>
</html>
