  {
    "name": "Forme",
    "settings": [
      {
        "type": "range",
        "id": "raza_carduri",
        "label": "Rotunjirea colțurilor",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "checkbox",
        "id": "butoane_rotunde",
        "label": "Butoane complet rotunjite",
        "default": true
      }
    ]
  },
  {
    "name": "Google și partajare",
    "settings": [
      {
        "type": "text",
        "id": "seo_titlu_acasa",
        "label": "Titlul paginii principale",
