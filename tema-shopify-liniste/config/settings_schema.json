[
  {
    "name": "theme_info",
    "theme_name": "Liniște",
    "theme_version": "1.0.0",
    "theme_author": "PAC Funerare Fetești",
    "theme_documentation_url": "https://github.com/flavianvalentinmoisa-sys/claude",
    "theme_support_url": "https://www.facebook.com/VasyPetre75"
  },
  {
    "name": "Datele firmei",
    "settings": [
      {
        "type": "paragraph",
        "content": "Aceste date se folosesc automat peste tot: în bara de sus, la butoanele de apel, în Contact, în subsol și în datele pentru Google."
      },
      {
        "type": "text",
        "id": "nume_firma",
        "label": "Numele firmei",
        "default": "PAC Funerare Fetești"
      },
      {
        "type": "text",
        "id": "telefon_principal",
        "label": "Telefon principal",
        "default": "0760 396 402",
        "info": "Folosit de butonul de apel de pe telefon și de butoanele „Sună la numărul principal”."
      },
      {
        "type": "text",
        "id": "telefon_secundar",
        "label": "Al doilea telefon",
        "default": "0760 522 022",
        "info": "Lăsați gol dacă nu există."
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email",
        "default": "pacfunerare@gmail.com"
      },
      {
        "type": "text",
        "id": "facebook",
        "label": "Adresa paginii de Facebook",
        "default": "https://www.facebook.com/VasyPetre75"
      },
      {
        "type": "header",
        "content": "Adresa"
      },
      {
        "type": "text",
        "id": "adresa_strada",
        "label": "Strada",
        "default": "Str. Călărași"
      },
      {
        "type": "text",
        "id": "adresa_localitate",
        "label": "Localitatea",
        "default": "Fetești"
      },
      {
        "type": "text",
        "id": "adresa_judet",
        "label": "Județul",
        "default": "Ialomița"
      },
      {
        "type": "text",
        "id": "adresa_reper",
        "label": "Reper",
        "default": "stația Policlinică, vis-à-vis de Liceul Teoretic „Carol I”"
      },
      {
        "type": "text",
        "id": "program",
        "label": "Program",
        "default": "NON-STOP – 24 de ore din 24, 7 zile din 7, inclusiv în sărbători"
      },
      {
        "type": "textarea",
        "id": "zona_deservita",
        "label": "Zona deservită (pentru Google)",
        "default": "Fetești-Oraș\nFetești-Gară\nBuliga\nVlașca\nLocalitățile din jurul Feteștiului, județul Ialomița\nTransport funerar în alte județe și repatrieri",
        "info": "Câte o localitate pe rând."
      }
    ]
  },
  {
    "name": "Sigla",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Sigla",
        "info": "Recomandat: PNG cu fundal transparent. Dacă nu alegeți nimic, apare sigla provizorie."
      },
      {
        "type": "range",
        "id": "latime_logo",
        "label": "Lățimea siglei în bara de sus",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "px",
        "default": 70
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Iconița din fila browserului",
        "info": "Pătrată, de exemplu 64 × 64 px."
      }
    ]
  },
