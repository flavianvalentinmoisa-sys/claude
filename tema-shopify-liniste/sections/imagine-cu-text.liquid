{%- liquid
  assign s = section.settings
  assign ancora = s.ancora | default: section.id | handleize
-%}
<section id="{{ ancora }}" class="sectiune culori-{{ s.culori }}"{% if s.titlu != blank %} aria-labelledby="titlu-{{ section.id }}"{% endif %}>
  <div class="pagina imagine-text imagine-text--{{ s.pozitie_poza }}">
    <div class="imagine-text__poza">
      {%- render 'imagine', poza: s.poza, rezerva: 'poza-provizorie.jpg', latime: 1000, inaltime: 1000, alt: s.descriere_poza, clasa: 'imagine-text__img', sizes: '(min-width: 768px) 50vw, 100vw' -%}
    </div>
    <div class="imagine-text__text">
      {%- if s.eticheta != blank -%}
        <p class="eticheta">{{ s.eticheta | escape }}</p>
      {%- endif -%}
      {%- if s.titlu != blank -%}
        <h2 class="sectiune__titlu" id="titlu-{{ section.id }}">{{ s.titlu | escape }}</h2>
        <span class="linie-fina linie-fina--stanga" aria-hidden="true"></span>
      {%- endif -%}
      <div class="text-bogat text-secundar">{{ s.text }}</div>
      <div class="grup-butoane">
        {%- render 'buton', text: s.buton_1_text, actiune: s.buton_1_actiune, link: s.buton_1_link, stil: s.buton_1_stil, mare: false -%}
      {%- render 'buton', text: s.buton_2_text, actiune: s.buton_2_actiune, link: s.buton_2_link, stil: s.buton_2_stil, mare: false -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagine cu text",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancora",
      "label": "Numele secțiunii (pentru linkuri)",
      "default": "despre-noi",
      "info": "Fără spații sau diacritice. Un link „#despre-noi” duce aici."
    },
    {
      "type": "select",
      "id": "culori",
      "label": "Schema de culori",
      "options": [
        {
          "value": "inchis",
          "label": "Închis (antracit)"
        },
        {
          "value": "deschis",
          "label": "Deschis (crem)"
        },
        {
          "value": "negru",
          "label": "Negru"
        }
      ],
      "default": "inchis"
    },
    {
      "type": "image_picker",
      "id": "poza",
      "label": "Poza"
    },
    {
      "type": "text",
      "id": "descriere_poza",
      "label": "Ce se vede în poză",
      "default": "Sediul firmei"
    },
    {
      "type": "select",
      "id": "pozitie_poza",
      "label": "Poza pe calculator",
      "options": [
        {
          "value": "stanga",
          "label": "În stânga"
        },
        {
          "value": "dreapta",
          "label": "În dreapta"
        }
      ],
      "default": "stanga"
    },
    {
      "type": "text",
      "id": "eticheta",
      "label": "Text mic deasupra titlului",
      "default": "Despre noi"
    },
    {
      "type": "text",
      "id": "titlu",
      "label": "Titlu",
      "default": "O firmă locală, pentru oamenii din zonă"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Câteva rânduri despre firmă.</p>"
    },
    {
      "type": "header",
      "content": "Butonul 1"
    },
    {
      "type": "text",
      "id": "buton_1_text",
      "label": "Text (gol = fără buton)",
      "default": "Sunați-ne"
    },
    {
      "type": "select",
      "id": "buton_1_actiune",
      "label": "Ce face",
      "options": [
        {
          "value": "telefon",
          "label": "Sună la numărul principal"
        },
        {
          "value": "telefon_2",
          "label": "Sună la al doilea număr"
        },
        {
          "value": "email",
          "label": "Deschide emailul"
        },
        {
          "value": "facebook",
          "label": "Deschide Facebook"
        },
        {
          "value": "link",
          "label": "Link scris mai jos"
        }
      ],
      "default": "telefon"
    },
    {
      "type": "text",
      "id": "buton_1_link",
      "label": "Link (doar pentru „Link scris mai jos”)",
      "info": "De exemplu #servicii sau /pages/contact"
    },
    {
      "type": "select",
      "id": "buton_1_stil",
      "label": "Aspect",
      "options": [
        {
          "value": "plin",
          "label": "Plin"
        },
        {
          "value": "contur",
          "label": "Doar contur"
        }
      ],
      "default": "plin"
    },
    {
      "type": "header",
      "content": "Butonul 2"
    },
    {
      "type": "text",
      "id": "buton_2_text",
      "label": "Text (gol = fără buton)"
    },
    {
      "type": "select",
      "id": "buton_2_actiune",
      "label": "Ce face",
      "options": [
        {
          "value": "telefon",
          "label": "Sună la numărul principal"
        },
        {
          "value": "telefon_2",
          "label": "Sună la al doilea număr"
        },
        {
          "value": "email",
          "label": "Deschide emailul"
        },
        {
          "value": "facebook",
          "label": "Deschide Facebook"
        },
        {
          "value": "link",
          "label": "Link scris mai jos"
        }
      ],
      "default": "link"
    },
    {
      "type": "text",
      "id": "buton_2_link",
      "label": "Link (doar pentru „Link scris mai jos”)",
      "info": "De exemplu #servicii sau /pages/contact"
    },
    {
      "type": "select",
      "id": "buton_2_stil",
      "label": "Aspect",
      "options": [
        {
          "value": "plin",
          "label": "Plin"
        },
        {
          "value": "contur",
          "label": "Doar contur"
        }
      ],
      "default": "contur"
    }
  ],
  "presets": [
    {
      "name": "Imagine cu text"
    }
  ]
}
{% endschema %}
