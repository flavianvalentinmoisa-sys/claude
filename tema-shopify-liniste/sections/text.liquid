{%- liquid
  assign s = section.settings
  assign ancora = s.ancora | default: section.id | handleize
  assign id_titlu = 'titlu-' | append: section.id
-%}
<section id="{{ ancora }}" class="sectiune culori-{{ s.culori }}"{% if s.titlu != blank %} aria-labelledby="{{ id_titlu }}"{% endif %}>
  <div class="pagina">
    {%- render 'antet-sectiune', eticheta: s.eticheta, titlu: s.titlu, introducere: s.introducere, id_titlu: id_titlu -%}

    <div class="text-centrat">
      {%- if s.text != blank -%}
        <div class="text-bogat text-secundar text-mare">{{ s.text }}</div>
      {%- endif -%}
      <div class="grup-butoane grup-butoane--centru">
        {%- render 'buton', text: s.buton_1_text, actiune: s.buton_1_actiune, link: s.buton_1_link, stil: s.buton_1_stil, mare: true -%}
      {%- render 'buton', text: s.buton_2_text, actiune: s.buton_2_actiune, link: s.buton_2_link, stil: s.buton_2_stil, mare: true -%}
      </div>
      {%- if s.arata_porumbel -%}
        {%- render 'porumbel', clasa: 'porumbel--mic' -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text cu butoane",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancora",
      "label": "Numele secțiunii (pentru linkuri)",
      "default": "apel",
      "info": "Fără spații sau diacritice. Un link „#apel” duce aici."
    },
    {
      "type": "select",
      "id": "culori",
      "label": "Schema de culori",
      "options": [
        {
          "value": "inchis",
          "label": "Închis (antracit)"
        },
        {
          "value": "deschis",
          "label": "Deschis (crem)"
        },
        {
          "value": "negru",
          "label": "Negru"
        }
      ],
      "default": "negru"
    },
    {
      "type": "text",
      "id": "eticheta",
      "label": "Text mic deasupra titlului"
    },
    {
      "type": "text",
      "id": "titlu",
      "label": "Titlu",
      "default": "Suntem aici, oricând aveți nevoie"
    },
    {
      "type": "textarea",
      "id": "introducere",
      "label": "Introducere"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Un singur telefon și ne ocupăm noi de tot.</p>"
    },
    {
      "type": "header",
      "content": "Butonul 1"
    },
    {
      "type": "text",
      "id": "buton_1_text",
      "label": "Text (gol = fără buton)",
      "default": "Sunați acum"
    },
    {
      "type": "select",
      "id": "buton_1_actiune",
      "label": "Ce face",
      "options": [
        {
          "value": "telefon",
          "label": "Sună la numărul principal"
        },
        {
          "value": "telefon_2",
          "label": "Sună la al doilea număr"
        },
        {
          "value": "email",
          "label": "Deschide emailul"
        },
        {
          "value": "facebook",
          "label": "Deschide Facebook"
        },
        {
          "value": "link",
          "label": "Link scris mai jos"
        }
      ],
      "default": "telefon"
    },
    {
      "type": "text",
      "id": "buton_1_link",
      "label": "Link (doar pentru „Link scris mai jos”)",
      "info": "De exemplu #servicii sau /pages/contact"
    },
    {
      "type": "select",
      "id": "buton_1_stil",
      "label": "Aspect",
      "options": [
        {
          "value": "plin",
          "label": "Plin"
        },
        {
          "value": "contur",
          "label": "Doar contur"
        }
      ],
      "default": "plin"
    },
    {
      "type": "header",
      "content": "Butonul 2"
    },
    {
      "type": "text",
      "id": "buton_2_text",
      "label": "Text (gol = fără buton)"
    },
    {
      "type": "select",
      "id": "buton_2_actiune",
      "label": "Ce face",
      "options": [
        {
          "value": "telefon",
          "label": "Sună la numărul principal"
        },
        {
          "value": "telefon_2",
          "label": "Sună la al doilea număr"
        },
        {
          "value": "email",
          "label": "Deschide emailul"
        },
        {
          "value": "facebook",
          "label": "Deschide Facebook"
        },
        {
          "value": "link",
          "label": "Link scris mai jos"
        }
      ],
      "default": "telefon_2"
    },
    {
      "type": "text",
      "id": "buton_2_link",
      "label": "Link (doar pentru „Link scris mai jos”)",
      "info": "De exemplu #servicii sau /pages/contact"
    },
    {
      "type": "select",
      "id": "buton_2_stil",
      "label": "Aspect",
      "options": [
        {
          "value": "plin",
          "label": "Plin"
        },
        {
          "value": "contur",
          "label": "Doar contur"
        }
      ],
      "default": "contur"
    },
    {
      "type": "checkbox",
      "id": "arata_porumbel",
      "label": "Arată porumbelul",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Text cu butoane"
    }
  ]
}
{% endschema %}
