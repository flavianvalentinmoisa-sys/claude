<section class="sectiune culori-negru parola">
  <div class="pagina pagina--ingusta text-centrat">
    {%- render 'logo', marime: 'mare', cu_nume: false -%}
    <h1 class="sectiune__titlu">{{ section.settings.titlu | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="text-secundar">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if settings.telefon_principal != blank -%}
      <div class="grup-butoane grup-butoane--centru">
        {%- render 'buton', text: section.settings.text_buton_apel, actiune: 'telefon', stil: 'plin', mare: true -%}
      </div>
    {%- endif -%}
    {%- form 'storefront_password', class: 'formular parola__formular' -%}
      {%- if form.errors -%}
        <div class="formular__eroare" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="parola">{{ 'parola.eticheta' | t }}</label>
      <input id="parola" type="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="buton buton--contur">{{ 'parola.buton' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Pagina cu parolă",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "titlu",
      "label": "Titlu",
      "default": "Site-ul se deschide în curând"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pentru orice situație, suntem disponibili NON-STOP la telefon."
    },
    {
      "type": "text",
      "id": "text_buton_apel",
      "label": "Textul butonului de apel",
      "default": "Sunați NON-STOP"
    }
  ]
}
{% endschema %}
