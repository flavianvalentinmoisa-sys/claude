      {
        "type": "header",
        "content": "Text de bază"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Font",
        "info": "Folosit doar când fonturile Carpatica sunt dezactivate."
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Scară",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_line_height",
        "label": "Înălțime rând",
