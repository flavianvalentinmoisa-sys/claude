            },
            {
              "value": "top-center",
              "label": "Sus centru"
            },
            {
              "value": "middle-left",
              "label": "Mijloc stânga"
            },
            {
              "value": "middle-center",
              "label": "Mijloc centru"
            },
            {
              "value": "middle-right",
              "label": "Mijloc dreapta"
            },
            {
              "value": "bottom-left",
              "label": "Jos stânga"
            },
            {
