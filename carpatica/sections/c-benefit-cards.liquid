{{ 'section-c-vivid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-vivid.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
<div class="c-bcards-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <ul
      class="c-bcards c-bcards--{{ s.style }}{% if s.mobile_slider %} c-bcards--mobile-slider{% endif %}"
      role="list"
      style="--c-cols: {{ s.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li
          class="c-bcard{% if b.link != blank %} c-bcard--link{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="--c-card-bg: {{ b.background }}; --c-card-text: {{ b.text_color }};{% if settings.animations_reveal_on_scroll %} --animation-order: {{ forloop.index }};{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if b.image != blank or b.video != blank -%}
            <div class="c-bcard__media c-bcard__media--{{ b.media_style }}">
              {%- render 'c-media', image: b.image, video: b.video, width: 800, widths: '200, 400, 800', sizes: '(min-width: 990px) 30vw, 80vw', alt: b.title -%}
            </div>
          {%- elsif b.emoji != blank -%}
            <span class="c-bcard__emoji" aria-hidden="true">{{ b.emoji }}</span>
          {%- elsif b.icon != 'none' -%}
            <span class="c-bcard__icon">{% render 'c-icon', name: b.icon, size: 30 %}</span>
          {%- endif -%}
          {%- if b.stat != blank -%}<p class="c-bcard__stat">{{ b.stat | escape }}</p>{%- endif -%}
          {%- if b.title != blank -%}<h3 class="c-bcard__title h4">{{ b.title }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<div class="c-bcard__text rte">{{ b.text }}</div>{%- endif -%}
          {%- if b.link != blank -%}
            <a href="{{ b.link }}" class="c-bcard__cta">
              {{- b.link_label | default: '→' | escape }} {% render 'c-icon', name: 'arrow_right', size: 16 -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- render 'c-buttons', s: s -%}
  </div>
</div>

