            "accent": "#FF5A1F"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Te bucuri de rezultat",
            "text": "<p>Iar dacă nu-ți place, ai retur gratuit 30 de zile.</p>",
            "accent": "#0F9D63"
          }
        }
      ]
    }
  ]
}
{% endschema %}
