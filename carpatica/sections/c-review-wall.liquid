{%- assign c_product_name = product.title | default: 'produsul nostru' -%}
{{ 'section-c-social.css' | asset_url | stylesheet_tag }}
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
{%- liquid
  assign star_style = 'stars'
  if s.star_style == 'trustpilot'
    assign star_style = 'trustpilot'
  endif
-%}
<div class="c-rwall color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section, product: product -%}
    {%- if s.show_summary -%}
      <div class="c-rwall__summary">
        <span class="c-rwall__score">{{ s.summary_label | escape }}</span>
        {%- render 'c-stars', rating: s.summary_rating, size: 26, style: star_style -%}
        <span class="c-rwall__based">{{ s.summary_text }}</span>
      </div>
    {%- endif -%}
    {%- capture cards -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="{% if s.layout == 'slider' %}c-slider__slide{% else %}c-rwall__item{% endif %}" {{ block.shopify_attributes }}>
          <article class="c-rcard color-{{ s.card_color_scheme }}">
            <div class="c-rcard__top">
              {%- render 'c-stars', rating: b.rating, size: 18, style: star_style -%}
              {%- if b.date != blank -%}<span class="c-rcard__date">{{ b.date | escape }}</span>{%- endif -%}
            </div>
            {%- if b.title != blank -%}<p class="c-rcard__title">{{ b.title | replace: '[produs]', c_product_name }}</p>{%- endif -%}
            <div class="c-rcard__text rte">{{ b.text | replace: '[produs]', c_product_name }}</div>
            <p class="c-rcard__author">
              <strong>{{ b.author | escape }}</strong>
              {%- if s.show_verified -%}<span class="c-rcard__verified c-text-savings">{% render 'c-icon', name: 'check_circle', size: 14 %}{{ 'carpatica.product.verified_buyer' | t }}</span>{%- endif -%}
            </p>
          </article>
        </li>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if s.layout == 'slider' -%}
      <c-slider class="c-slider__peek" data-autoplay="{% if s.autoplay %}6{% endif %}" style="--c-per-view: {{ s.columns_desktop }}; --c-per-view-mobile: 1; --c-slider-gap: 1.6rem;">
        <ul class="c-slider__track" role="list">{{ cards }}</ul>
        {%- render 'c-slider-controls' -%}
      </c-slider>
    {%- else -%}
      <ul class="c-rwall__grid" role="list" style="--c-cols: {{ s.columns_desktop }};">{{ cards }}</ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Recenzii verificate",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Supratitlu"
