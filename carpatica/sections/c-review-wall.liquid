          "id": "text",
          "label": "Text",
          "default": "<p>Comandă simplă, livrare în două zile, produs de calitate. Voi mai comanda.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nume",
          "default": "Daniel S."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Dată",
          "default": "acum 3 zile"
        }
      ]
