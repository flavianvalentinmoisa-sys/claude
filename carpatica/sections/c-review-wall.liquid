          "value": "trustpilot",
          "label": "Pătrate verzi (stil Trustpilot)"
        },
        {
          "value": "stars",
          "label": "Stele clasice"
        }
      ],
      "default": "trustpilot"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Aranjare",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grilă"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Coloane pe desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Derulare automată",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "„Cumpărător verificat”",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Schemă de culori card",
