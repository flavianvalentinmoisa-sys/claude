{%- assign c_product_name = product.title | default: 'produsul nostru' -%}
{{ 'section-c-vivid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-vivid.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- liquid
  assign s = section.settings
  assign good_image = s.good_image
  if good_image == blank and s.good_video == blank and s.use_product_image and product != blank
    assign good_image = product.featured_media.preview_image
  endif
-%}
<div class="c-ps-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section, product: product -%}
    <div class="c-ps">
      <div class="c-ps__col c-ps__col--bad{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if s.bad_image != blank or s.bad_video != blank -%}
          <div class="c-ps__media">
            {%- render 'c-media', image: s.bad_image, video: s.bad_video, width: 900, widths: '400, 700, 900', sizes: '(min-width: 750px) 45vw, 90vw', alt: s.bad_title -%}
          </div>
        {%- endif -%}
        <p class="c-ps__title h4">{{ s.bad_title | replace: '[produs]', c_product_name }}</p>
        <ul class="c-ps__list" role="list">
          {%- assign lines = s.bad_list | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              <li><span class="c-ps__mark" aria-hidden="true">✕</span>{{ line | replace: '[produs]', c_product_name }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <span class="c-ps__vs" aria-hidden="true">{{ s.vs_text | replace: '[produs]', c_product_name | escape }}</span>
      <div class="c-ps__col c-ps__col--good color-{{ s.good_color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if settings.animations_reveal_on_scroll %} style="--animation-order: 2;"{% endif %}>
        {%- if s.good_badge != blank -%}<span class="c-ps__badge">{{ s.good_badge | replace: '[produs]', c_product_name | escape }}</span>{%- endif -%}
        {%- if good_image != blank or s.good_video != blank -%}
          <div class="c-ps__media">
            {%- render 'c-media', image: good_image, video: s.good_video, width: 900, widths: '400, 700, 900', sizes: '(min-width: 750px) 45vw, 90vw', alt: s.good_title -%}
          </div>
        {%- endif -%}
        <p class="c-ps__title h4">{{ s.good_title | replace: '[produs]', c_product_name }}</p>
        <ul class="c-ps__list" role="list">
          {%- assign lines = s.good_list | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            {%- assign line = line | strip -%}
            {%- if line != blank -%}
              <li><span class="c-ps__mark" aria-hidden="true">✓</span>{{ line | replace: '[produs]', c_product_name }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- render 'c-buttons', s: s -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Problemă vs soluție",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Supratitlu",
      "default": "Diferența se vede"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titlu",
      "default": "Fără noi vs. <em>cu noi</em>",
      "info": "Scrie un cuvânt cu italic ca să primească culoarea de accent. [produs] devine numele produsului pe pagina lui."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Mărime titlu",
      "options": [
        {
          "value": "h4",
          "label": "Mic"
        },
        {
          "value": "h3",
          "label": "Mediu"
        },
        {
          "value": "h2",
          "label": "Mare"
        },
        {
          "value": "h1",
          "label": "Foarte mare"
        },
        {
          "value": "h0",
          "label": "Extra mare"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Aliniere titlu",
      "options": [
        {
          "value": "left",
          "label": "Stânga"
        },
        {
          "value": "center",
          "label": "Centru"
        },
        {
          "value": "right",
          "label": "Dreapta"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "vs_text",
      "label": "Text între coloane",
      "default": "VS"
    },
    {
      "type": "header",
      "content": "Coloana „problemă”"
    },
    {
      "type": "image_picker",
      "id": "bad_image",
      "label": "Imagine sau GIF",
      "info": "Poți încărca și GIF-uri animate – animația se păstrează."
    },
    {
      "type": "video",
      "id": "bad_video",
      "label": "Sau video",
      "info": "Video fără sunet, în buclă, ca un GIF (mai ușor decât un GIF). Are prioritate față de imagine."
    },
    {
      "type": "inline_richtext",
      "id": "bad_title",
      "label": "Titlu",
      "default": "Fără [produs]"
    },
    {
      "type": "textarea",
      "id": "bad_list",
      "label": "Probleme (câte una pe rând)",
      "default": "Nopți agitate\nOboseală dimineața\nSoluții scumpe care nu țin"
    },
    {
      "type": "header",
      "content": "Coloana „soluție”"
    },
    {
      "type": "text",
      "id": "good_badge",
      "label": "Etichetă",
      "default": "Recomandat"
    },
    {
      "type": "image_picker",
      "id": "good_image",
      "label": "Imagine sau GIF",
      "info": "Poți încărca și GIF-uri animate – animația se păstrează."
    },
    {
      "type": "video",
      "id": "good_video",
      "label": "Sau video",
      "info": "Video fără sunet, în buclă, ca un GIF (mai ușor decât un GIF). Are prioritate față de imagine."
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Pe pagina de produs, folosește poza produsului dacă nu alegi alta",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "good_title",
      "label": "Titlu",
      "default": "Cu [produs]"
    },
    {
      "type": "textarea",
      "id": "good_list",
      "label": "Beneficii (câte unul pe rând)",
      "default": "Somn liniștit din prima noapte\nEnergie toată ziua\nO investiție care ține ani"
    },
    {
      "type": "color_scheme",
      "id": "good_color_scheme",
      "label": "Schemă de culori soluție",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Butoane"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Text buton 1",
      "default": "Vreau și eu"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Link buton 1"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "Stil buton 1",
      "options": [
        {
          "value": "primary",
          "label": "Plin"
        },
        {
          "value": "secondary",
          "label": "Contur"
        },
        {
          "value": "white",
          "label": "Alb"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Text buton 2"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Link buton 2"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Stil buton 2",
      "options": [
        {
          "value": "primary",
          "label": "Plin"
        },
        {
          "value": "secondary",
          "label": "Contur"
        },
        {
          "value": "white",
          "label": "Alb"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Stil secțiune"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemă de culori",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Afișează pe",
      "options": [
        {
          "value": "all",
          "label": "Toate dispozitivele"
        },
        {
          "value": "desktop",
          "label": "Doar desktop"
        },
        {
          "value": "mobile",
          "label": "Doar mobil"
        }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID secțiune (ancoră)",
      "info": "Folosit de butoanele de derulare. Ex: recenzii → link #recenzii."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spațiere sus",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spațiere jos",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ]
}
{% endschema %}
