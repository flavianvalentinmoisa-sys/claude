{{ 'section-c-vivid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-vivid.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size
  assign initial = s.initial_count
  if request.design_mode
    assign initial = total
  endif
-%}
<div class="c-previews-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}

    {%- if s.show_summary -%}
      <div class="c-rsummary color-{{ s.card_color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="c-rsummary__score">
          <span class="c-rsummary__value">{{ s.rating_value }}</span>
          <div>
            {%- assign rating_number = s.rating_value | replace: ',', '.' | plus: 0 -%}
            {%- render 'c-stars', rating: rating_number, size: 20 -%}
            <p class="c-rsummary__count">{{ s.rating_count }}</p>
          </div>
        </div>
        {%- if s.show_bars -%}
          <ul class="c-rsummary__bars" role="list">
            {%- assign bars = s.bar_5 | append: ',' | append: s.bar_4 | append: ',' | append: s.bar_3 | append: ',' | append: s.bar_2 | append: ',' | append: s.bar_1 | split: ',' -%}
            {%- for bar in bars -%}
              {%- assign stars = 6 | minus: forloop.index -%}
              <li class="c-rsummary__bar">
                <span>{{ stars }} ★</span>
                <span class="c-rsummary__track"><span style="width: {{ bar }}%;"></span></span>
                <span class="c-rsummary__pct">{{ bar }}%</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.summary_button_label != blank -%}
          <a href="{{ s.summary_button_link | default: '#' }}" class="button button--secondary">{{ s.summary_button_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <c-lightbox>
      <c-load-more data-step="{{ s.initial_count }}">
        <ul
          class="c-previews c-previews--{{ s.layout }}"
          role="list"
          style="--c-cols: {{ s.columns_desktop }}; --c-cols-mobile: {{ s.columns_mobile }};"
        >
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <li
              class="c-preview color-{{ s.card_color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if forloop.index > initial %}
                hidden
                data-more-item
              {% endif %}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index | modulo: 6 }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if b.video != blank -%}
                <div class="c-preview__media">
                  {%- render 'c-media', video: b.video, image: b.image, alt: b.name -%}
                </div>
              {%- elsif b.image != blank -%}
                {%- capture caption -%}<strong>{{ b.name | escape }}</strong>{% if b.title != blank %} – {{ b.title | escape }}{% endif %}{%- endcapture -%}
                <button
                  type="button"
                  class="c-preview__media c-preview__zoom"
                  data-lightbox-src="{{ b.image | image_url: width: 1600 }}"
                  data-lightbox-alt="{{ b.image.alt | default: b.name | escape }}"
                  data-lightbox-caption="{{ caption | escape }}"
                  aria-label="{{ 'carpatica.reviews.open_photo' | t: name: b.name | escape }}"
                >
                  {%- render 'c-media', image: b.image, width: 800, widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: b.name -%}
                  {%- if b.image_2 != blank -%}<span class="c-preview__more">+1</span>{%- endif -%}
                </button>
                {%- if b.image_2 != blank -%}
                  <span hidden data-lightbox-src="{{ b.image_2 | image_url: width: 1600 }}" data-lightbox-alt="{{ b.image_2.alt | default: b.name | escape }}" data-lightbox-caption="{{ caption | escape }}"></span>
                {%- endif -%}
              {%- endif -%}
              <div class="c-preview__body">
                <div class="c-preview__top">
                  {%- render 'c-stars', rating: b.rating, size: 16 -%}
                  {%- if s.show_date and b.date != blank -%}<span class="c-preview__date">{{ b.date | escape }}</span>{%- endif -%}
                </div>
                {%- if b.title != blank -%}<p class="c-preview__title">{{ b.title | escape }}</p>{%- endif -%}
                {%- if b.text != blank -%}<div class="c-preview__text rte">{{ b.text }}</div>{%- endif -%}
                <div class="c-preview__author">
                  {%- if b.avatar != blank -%}
                    {{ b.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: b.name, class: 'c-preview__avatar', width: 40, height: 40 }}
                  {%- else -%}
                    <span class="c-preview__avatar c-preview__avatar--initial" aria-hidden="true">{{ b.name | slice: 0 | upcase }}</span>
                  {%- endif -%}
                  <span>
                    <strong>{{ b.name | escape }}</strong>
                    {%- if b.location != blank %} <span class="c-preview__location">· {{ b.location | escape }}</span>{% endif -%}
                    {%- if s.show_verified and b.verified -%}
                      <span class="c-preview__verified">{% render 'c-icon', name: 'check_circle', size: 14 %} {{ s.verified_text | escape }}</span>
                    {%- endif -%}
                  </span>
                </div>
                {%- if b.product != blank -%}
                  <a href="{{ b.product.url }}" class="c-preview__product">
                    {%- if b.product.featured_image != blank -%}
                      {{ b.product.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: b.product.title, width: 36, height: 36 }}
                    {%- endif -%}
                    <span>{{ b.product.title | escape }}</span>
                  </a>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if total > initial -%}
          <div class="c-load-more__actions">
            <button type="button" class="button button--secondary" data-load-more>{{ s.load_more_label | escape }}</button>
          </div>
        {%- endif -%}
      </c-load-more>

      <dialog class="c-lightbox" aria-label="{{ 'carpatica.reviews.gallery' | t }}">
        <button type="button" class="c-lightbox__close" data-lightbox-close aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'c-icon', name: 'close', size: 22 -%}
        </button>
        <figure class="c-lightbox__figure">
          <img class="c-lightbox__image" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" width="1600" height="1600">
          <figcaption class="c-lightbox__caption"></figcaption>
        </figure>
        <div class="c-lightbox__nav">
          <button type="button" data-lightbox-prev aria-label="{{ 'carpatica.general.previous' | t }}">{{- 'icon-arrow.svg' | inline_asset_content -}}</button>
          <span class="c-lightbox__counter"></span>
          <button type="button" data-lightbox-next aria-label="{{ 'carpatica.general.next' | t }}">{{- 'icon-arrow.svg' | inline_asset_content -}}</button>
        </div>
      </dialog>
    </c-lightbox>
  </div>
</div>

{% schema %}
{
  "name": "Recenzii cu poze",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Supratitlu",
      "default": "Recenzii reale"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titlu",
      "default": "Peste 2.000 de clienți <em>fericiți</em>",
      "info": "Scrie un cuvânt cu italic ca să primească culoarea de accent."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Mărime titlu",
      "options": [
        {
          "value": "h4",
          "label": "Mic"
        },
        {
          "value": "h3",
          "label": "Mediu"
        },
        {
          "value": "h2",
          "label": "Mare"
        },
        {
          "value": "h1",
          "label": "Foarte mare"
        },
        {
          "value": "h0",
          "label": "Extra mare"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Aliniere titlu",
      "options": [
        {
          "value": "left",
          "label": "Stânga"
        },
        {
          "value": "center",
          "label": "Centru"
        },
        {
          "value": "right",
          "label": "Dreapta"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Rezumat rating"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Afișează rezumatul",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Nota medie",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Text număr recenzii",
      "default": "din 2.143 de recenzii verificate"
    },
    {
      "type": "checkbox",
      "id": "show_bars",
      "label": "Bare pe stele",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_5",
      "label": "5 stele",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 89,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bar_4",
      "label": "4 stele",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 8,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bar_3",
      "label": "3 stele",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 2,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bar_2",
      "label": "2 stele",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bar_1",
      "label": "1 stea",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "summary_button_label",
      "label": "Text buton"
    },
    {
      "type": "url",
      "id": "summary_button_link",
      "label": "Link buton"
    },
    {
      "type": "header",
      "content": "Recenzii"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Aranjare",
      "options": [
        {
          "value": "masonry",
          "label": "Mozaic (Pinterest)"
        },
        {
          "value": "grid",
          "label": "Grilă egală"
        }
      ],
      "default": "masonry"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Coloane pe desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Coloane pe mobil",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "initial_count",
      "label": "Recenzii afișate la început",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "info": "Restul apar la „Vezi mai multe”."
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Text buton „Vezi mai multe”",
      "default": "Vezi mai multe recenzii"
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Bifă „Cumpărător verificat”",
      "default": true
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Text verificat",
      "default": "Cumpărător verificat"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Afișează data",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Schemă de culori card",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Stil secțiune"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemă de culori",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Afișează pe",
      "options": [
        {
          "value": "all",
          "label": "Toate dispozitivele"
        },
        {
          "value": "desktop",
          "label": "Doar desktop"
        },
        {
          "value": "mobile",
          "label": "Doar mobil"
        }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID secțiune (ancoră)",
      "info": "Folosit de butoanele de derulare. Ex: recenzii → link #recenzii."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spațiere sus",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spațiere jos",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recenzie",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Poză client",
          "info": "Poți încărca și GIF-uri animate – animația se păstrează."
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "A doua poză"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Sau video",
          "info": "Video fără sunet, în buclă, ca un GIF (mai ușor decât un GIF). Are prioritate față de imagine."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stele",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titlu",
          "default": "Exact ce căutam!"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Am primit coletul în 2 zile, calitatea e peste așteptări. Recomand cu drag!</p>"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nume",
          "default": "Andreea M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Oraș",
          "default": "Cluj-Napoca"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Dată",
          "default": "acum 3 zile"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Poză profil"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Cumpărător verificat",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produs recenzat"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recenzii cu poze",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
