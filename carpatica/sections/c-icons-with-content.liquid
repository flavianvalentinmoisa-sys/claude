{{ 'section-c-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-landing.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
{%- assign icon_blocks = section.blocks | where: 'type', 'icon' -%}
{%- assign half = icon_blocks.size | plus: 1 | divided_by: 2 -%}
<div class="c-iwc-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <div class="c-iwc">
      <ul class="c-iwc__col c-iwc__col--left" role="list">
        {%- for block in icon_blocks limit: half -%}{%- render 'c-feature-bullet', block: block -%}{%- endfor -%}
      </ul>
      <div class="c-iwc__media" style="--c-media-radius: {{ s.radius }}px;">
        {%- if s.video != blank -%}
          {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1000x' }}
        {%- elsif s.image != blank -%}
          {%- if s.image.src contains '.gif' or s.image.src contains '.GIF' -%}{%- render 'c-gif', image: s.image, loading: 'lazy' -%}{%- else -%}{{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 990px) 35vw, 90vw' }}{%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <ul class="c-iwc__col c-iwc__col--right" role="list">
        {%- for block in icon_blocks offset: half -%}{%- render 'c-feature-bullet', block: block -%}{%- endfor -%}
      </ul>
    </div>
    <div class="c-iwc__footer c-align-center">
      {%- render 'c-buttons', s: s -%}
      {%- if s.atc_product != blank and s.atc_product.has_only_default_variant -%}
        <button type="button" class="button" data-quick-add="{{ s.atc_product.selected_or_first_available_variant.id }}">
          <span>{{ s.atc_label | escape }}</span>
          {%- render 'loading-spinner' -%}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

