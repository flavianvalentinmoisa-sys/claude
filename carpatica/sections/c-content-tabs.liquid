{{ 'section-c-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-landing.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
<div class="c-tabs-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <content-tabs class="c-tabs c-tabs--{{ s.style }}">
      <div class="c-tabs__list" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            class="c-tabs__tab"
            id="Tab-{{ block.id }}"
            aria-controls="TabPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {% unless forloop.first %}tabindex="-1"{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- render 'c-icon', name: block.settings.icon, size: 18 -%}
            {{ block.settings.title | escape }}
          </button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="c-tabs__panel c-tabs__panel--{{ b.image_position }}" role="tabpanel" id="TabPanel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- if b.image != blank -%}
            <div class="c-tabs__image">{{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 990px) 50vw, 100vw' }}</div>
          {%- endif -%}
          <div class="c-tabs__content">
            {%- if b.heading != blank -%}<h3 class="c-tabs__heading h3">{{ b.heading }}</h3>{%- endif -%}
            <div class="rte">{{ b.content }}{{ b.page.content }}</div>
            {%- if b.button_label != blank -%}<a href="{{ b.button_link | default: '#' }}" class="button">{{ b.button_label | escape }}</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </content-tabs>
  </div>
</div>

