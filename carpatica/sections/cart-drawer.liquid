{% comment %}
  Coș lateral Carpatica (secțiune statică randată din layout/theme.liquid).
  Zone: sus (bare de progres, timer), conținut (produse + upsell, cadou...), jos (fix).
{% endcomment %}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'carpatica-cart.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'carpatica-cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  assign top_types = 'progress_bar,checkpoints_bar,countdown_timer'
  assign footer_types = 'discount_field,cart_note,subtotals,tnc_checkbox,checkout_button,payment_badges'
  assign continue_url = settings.continue_shopping_url | default: routes.all_products_collection_url
-%}

<cart-drawer
  class="drawer c-drawer{% if cart == empty %} is-empty{% endif %}"
  data-section-id="{{ section.id }}"
  style="--c-drawer-width: {{ section.settings.width }}px;"
>
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner c-drawer__inner gradient color-{{ section.settings.color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
      data-cart-total="{{ cart.total_price }}"
      data-item-count="{{ cart.item_count }}"
    >
      <div class="drawer__header c-drawer__header">
        <h2 class="drawer__heading c-drawer__heading">
          {%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ 'sections.cart.title' | t }}{%- endif -%}
          {%- if section.settings.show_count and cart.item_count > 0 -%}
            <span class="c-drawer__count">{{ cart.item_count }}</span>
          {%- endif -%}
        </h2>
        <button
          class="drawer__close c-drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      {%- if cart != empty -%}
        <div class="c-drawer__top">
          {%- for block in section.blocks -%}
            {%- assign zone_type = block.type | append: ',' -%}
            {%- assign top_list = top_types | append: ',' -%}
            {%- if top_list contains zone_type -%}
              {%- render 'c-cart-block', block: block, section: section, context: 'drawer' -%}
            {%- elsif block.settings.position == 'top' -%}
              {%- render 'c-cart-block', block: block, section: section, context: 'drawer' -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="c-drawer__scroll">
        {%- if cart == empty -%}
          <div class="drawer__inner-empty c-drawer__empty">
            <div class="cart-drawer__warnings center">
              <div class="cart-drawer__empty-content">
                <span class="c-drawer__empty-icon">{%- render 'cart-icon' -%}</span>
                <h2 class="cart__empty-text">
                  {%- if section.settings.empty_heading != blank -%}{{ section.settings.empty_heading | escape }}{%- else -%}{{ 'sections.cart.empty' | t }}{%- endif -%}
                </h2>
                {%- if section.settings.empty_text != blank -%}
                  <div class="rte c-drawer__empty-text">{{ section.settings.empty_text }}</div>
                {%- endif -%}
                {%- if settings.show_continue_shopping -%}
                  <a href="{{ continue_url }}" class="button">
                    {{ 'general.continue_shopping' | t }}
                  </a>
                {%- endif -%}
                {%- if shop.customer_accounts_enabled and customer == null and section.settings.show_login -%}
                  <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                  <p class="cart__login-paragraph">
                    {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                  </p>
                {%- endif -%}
              </div>
            </div>
            {%- if settings.cart_drawer_collection != blank -%}
              <div class="cart-drawer__collection">
                {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- render 'c-cart-drawer-items', section: section -%}

        {%- if cart != empty -%}
          <div class="c-drawer__body">
            {%- for block in section.blocks -%}
              {%- assign zone_type = block.type | append: ',' -%}
              {%- assign top_list = top_types | append: ',' -%}
              {%- assign footer_list = footer_types | append: ',' -%}
              {%- if top_list contains zone_type or footer_list contains zone_type -%}
                {%- continue -%}
              {%- endif -%}
              {%- if block.settings.position == 'top' or block.settings.position == 'footer' -%}
                {%- continue -%}
              {%- endif -%}
              {%- render 'c-cart-block', block: block, section: section, context: 'drawer' -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if cart != empty -%}
        <div class="drawer__footer c-drawer__footer">
          {%- for block in section.blocks -%}
            {%- assign zone_type = block.type | append: ',' -%}
            {%- assign footer_list = footer_types | append: ',' -%}
            {%- if footer_list contains zone_type or block.settings.position == 'footer' -%}
              {%- render 'c-cart-block', block: block, section: section, context: 'drawer' -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

