{{ 'section-c-social.css' | asset_url | stylesheet_tag }}
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
<div class="c-fb color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <ul class="c-fb__list c-fb__list--{{ s.layout }}" role="list" style="--c-cols: {{ s.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="c-fb__item" {{ block.shopify_attributes }}>
          <article class="c-fb__comment">
            <span class="c-fb__avatar">
              {%- if b.avatar != blank -%}
                {{ b.avatar | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', sizes: '40px', alt: b.name }}
              {%- else -%}
                <span class="c-fb__initial">{{ b.name | slice: 0 }}</span>
              {%- endif -%}
            </span>
            <div class="c-fb__content">
              <div class="c-fb__bubble">
                <p class="c-fb__name">{{ b.name | escape }}</p>
                <div class="c-fb__text">{{ b.text }}</div>
                {%- if b.likes > 0 -%}
                  <span class="c-fb__reactions">
                    {%- if b.reaction_like -%}<span class="c-fb__reaction c-fb__reaction--like" aria-hidden="true"><svg viewBox="0 0 16 16"><path fill="#fff" d="M4 7h2v6H4zM7 13V7.4L9.2 3c.9 0 1.5.8 1.3 1.6L10 7h3c.7 0 1.2.7 1 1.4l-1.2 3.8c-.2.5-.6.8-1.1.8z"/></svg></span>{%- endif -%}
                    {%- if b.reaction_love -%}<span class="c-fb__reaction c-fb__reaction--love" aria-hidden="true"><svg viewBox="0 0 16 16"><path fill="#fff" d="M8 13.2S3 10.2 3 6.6A2.6 2.6 0 018 5.5a2.6 2.6 0 015 1.1c0 3.6-5 6.6-5 6.6z"/></svg></span>{%- endif -%}
                    <span class="c-fb__count">{{ b.likes }}</span>
                  </span>
                {%- endif -%}
              </div>
              {%- if b.image != blank -%}
                <div class="c-fb__image">{{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '300px' }}</div>
              {%- endif -%}
              <p class="c-fb__actions">
                <span>{{ s.like_label | escape }}</span>
                <span>{{ s.reply_label | escape }}</span>
                {%- if b.time != blank -%}<span class="c-fb__time">{{ b.time | escape }}</span>{%- endif -%}
              </p>
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Comentarii Facebook",
  "tag": "section",
  "class": "section",
  "settings": [
    {
