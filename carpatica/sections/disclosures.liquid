{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture disclosures_content -%}
  {%- render 'product-disclosures',
    product: product,
    heading: section.settings.heading,
    heading_size: section.settings.heading_size,
    open_by_default: section.settings.open_by_default,
    surface: 'product_page'
  -%}
{%- endcapture -%}

{%- unless disclosures_content == blank -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {{ disclosures_content }}
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Avertizări",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Avertizări de siguranță și informații obligatorii pentru acest produs."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Avertizări"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Mic"
        },
        {
          "value": "h1",
          "label": "Mediu"
        },
        {
          "value": "h0",
          "label": "Mare"
        }
      ],
      "default": "h2",
      "label": "Mărime titlu"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Deschis implicit",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemă de culori",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spațiere interioară"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Sus",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Jos",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Avertizări"
    }
  ]
}
{% endschema %}
