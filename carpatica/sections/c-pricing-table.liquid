  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Pachet",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Etichetă"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagine"
        },
        {
