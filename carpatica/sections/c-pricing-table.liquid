{{ 'section-c-landing.css' | asset_url | stylesheet_tag }}
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
<div class="c-pricing-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <div class="c-pricing" style="--c-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="c-plan color-{% if b.highlight %}{{ s.highlight_color_scheme }}{% else %}{{ s.card_color_scheme }}{% endif %}{% if b.highlight %} c-plan--highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}<span class="c-plan__badge">{{ b.badge | escape }}</span>{%- endif -%}
          {%- if b.image != blank -%}<div class="c-plan__image">{%- if b.image.src contains '.gif' or b.image.src contains '.GIF' -%}{%- render 'c-gif', image: b.image, loading: 'lazy' -%}{%- else -%}{{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '300px' }}{%- endif -%}</div>{%- endif -%}
          <p class="c-plan__name h4">{{ b.name | escape }}</p>
          {%- if b.description != blank -%}<p class="c-plan__desc">{{ b.description }}</p>{%- endif -%}
          <p class="c-plan__price">
            <span class="c-plan__amount">{{ b.price | escape }}</span>
            {%- if b.compare_price != blank -%}<s>{{ b.compare_price | escape }}</s>{%- endif -%}
            {%- if b.price_note != blank -%}<span class="c-plan__note">{{ b.price_note | escape }}</span>{%- endif -%}
          </p>
          {%- assign lines = b.features | newline_to_br | split: '<br />' -%}
          <ul class="c-plan__features" role="list">
            {%- for line in lines -%}
              {%- assign l = line | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- assign first = l | slice: 0 -%}
              {%- if first == '-' -%}
                <li class="is-off">{% render 'c-icon', name: 'close', size: 16 %}<span>{{ l | remove_first: '-' | strip }}</span></li>
              {%- else -%}
                <li>{% render 'c-icon', name: 'check', size: 16 %}<span>{{ l | remove_first: '+' | strip }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if b.button_label != blank -%}
            <a href="{{ b.product.url | default: b.button_link | default: '#' }}" class="button button--full-width{% unless b.highlight %} button--secondary{% endunless %}">{{ b.button_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tabel de prețuri",
  "tag": "section",
  "class": "section",
  "settings": [
    {
