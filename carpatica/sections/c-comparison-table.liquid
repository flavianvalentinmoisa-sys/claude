      "info": "Scrie un cuvânt cu italic ca să primească culoarea de accent."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Mărime titlu",
      "options": [
        {
          "value": "h4",
          "label": "Mic"
        },
        {
          "value": "h3",
          "label": "Mediu"
        },
        {
          "value": "h2",
          "label": "Mare"
        },
        {
          "value": "h1",
          "label": "Foarte mare"
        },
        {
          "value": "h0",
          "label": "Extra mare"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Aliniere titlu",
      "options": [
        {
          "value": "left",
          "label": "Stânga"
        },
        {
          "value": "center",
          "label": "Centru"
        },
        {
          "value": "right",
          "label": "Dreapta"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "Titlu coloană caracteristici",
      "default": "Caracteristici"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Numele tău",
      "default": "Noi"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Sau logo"
    },
    {
      "type": "text",
      "id": "competitor_1",
      "label": "Concurent 1",
      "default": "Alții"
    },
    {
      "type": "text",
      "id": "competitor_2",
      "label": "Concurent 2 (opțional)"
    },
    {
      "type": "select",
      "id": "accent",
      "label": "Culoare coloana ta",
      "options": [
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "savings",
          "label": "Verde"
        }
      ],
      "default": "accent"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text buton",
      "default": "Comandă acum"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link buton"
    },
    {
      "type": "header",
      "content": "Stil secțiune"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemă de culori",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Afișează pe",
      "options": [
        {
          "value": "all",
          "label": "Toate dispozitivele"
        },
        {
          "value": "desktop",
          "label": "Doar desktop"
        },
        {
          "value": "mobile",
          "label": "Doar mobil"
        }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID secțiune (ancoră)",
      "info": "Folosit de butoanele de derulare. Ex: recenzii → link #recenzii."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spațiere sus",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spațiere jos",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Rând",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "feature",
          "label": "Caracteristică",
          "default": "Livrare în 24–48 de ore"
        },
        {
          "type": "text",
          "id": "us",
          "label": "Valoare noi",
          "default": "yes",
          "info": "yes = bifă, no = x, partial = ~ sau orice text."
        },
        {
          "type": "text",
          "id": "comp_1",
          "label": "Valoare concurent 1",
          "default": "no"
        },
        {
          "type": "text",
          "id": "comp_2",
          "label": "Valoare concurent 2",
          "default": "no"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabel comparativ",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row",
          "settings": {
            "feature": "Plata ramburs la curier",
            "comp_1": "partial"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Retur gratuit 30 de zile"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Garanție 2 ani"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Suport clienți în română"
          }
        }
      ]
    }
  ]
}
{% endschema %}
