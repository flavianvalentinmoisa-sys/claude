{{ 'section-c-social.css' | asset_url | stylesheet_tag }}
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
{%- liquid
  assign competitors = 1
  if s.competitor_2 != blank
    assign competitors = 2
  endif
-%}
<div class="c-compare-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <div class="c-compare-wrap" style="--c-compare-accent: var(--color-{{ s.accent }});">
      <table class="c-compare c-compare--{{ competitors }}">
        <thead>
          <tr>
            <th scope="col" class="c-compare__feature-head">{{ s.feature_label | escape }}</th>
            <th scope="col" class="c-compare__us">
              {%- if s.logo != blank -%}
                {{ s.logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: s.brand_name, class: 'c-compare__logo' }}
              {%- else -%}
                {{ s.brand_name | escape }}
              {%- endif -%}
            </th>
            <th scope="col">{{ s.competitor_1 | escape }}</th>
            {%- if competitors == 2 -%}<th scope="col">{{ s.competitor_2 | escape }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="c-compare__feature">{{ b.feature }}</th>
              {%- for i in (0..competitors) -%}
                {%- liquid
                  case i
                    when 0
                      assign val = b.us
                    when 1
                      assign val = b.comp_1
                    else
                      assign val = b.comp_2
                  endcase
                -%}
                <td class="{% if i == 0 %}c-compare__us{% endif %}">
                  {%- case val -%}
                    {%- when 'yes' -%}<span class="c-compare__yes" aria-label="Da">{% render 'c-icon', name: 'check', size: 18 %}</span>
                    {%- when 'no' -%}<span class="c-compare__no" aria-label="Nu">{% render 'c-icon', name: 'close', size: 16 %}</span>
                    {%- when 'partial' -%}<span class="c-compare__partial" aria-label="Parțial">~</span>
                    {%- else -%}{{ val }}
                  {%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if s.button_label != blank -%}
      <div class="c-align-center c-compare__cta"><a href="{{ s.button_link | default: '#' }}" class="button">{{ s.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tabel comparativ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Supratitlu"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titlu",
