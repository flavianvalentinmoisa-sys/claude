        },
        {
          "type": "range",
          "id": "y",
          "label": "Poziție verticală",
          "min": -20,
          "max": 100,
          "step": 2,
          "default": 16,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "width",
          "label": "Lățime",
          "min": 5,
          "max": 100,
          "step": 1,
          "default": 30,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "width_mobile",
          "label": "Lățime pe mobil",
          "min": 5,
          "max": 100,
          "step": 1,
          "default": 45,
