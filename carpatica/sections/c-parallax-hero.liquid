    {
      "type": "layer",
      "name": "Strat imagine",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagine (PNG transparent)"
        },
        {
          "type": "range",
          "id": "depth",
          "label": "Adâncime (mișcare)",
