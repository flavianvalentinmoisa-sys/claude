{%- assign c_product_name = product.title | default: 'produsul nostru' -%}
{{ 'section-c-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-landing.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
<div class="c-features-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section, product: product -%}
    <shoppable-image class="c-features c-features--{{ s.layout }}" style="--c-hotspot-color: rgb(var(--color-accent)); --c-media-radius: {{ s.radius }}px;">
      {%- capture bullets_left -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bullet' and block.settings.side == 'left' -%}{%- render 'c-feature-bullet', block: block -%}{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- capture bullets_right -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bullet' and block.settings.side != 'left' -%}{%- render 'c-feature-bullet', block: block -%}{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      <ul class="c-features__col c-features__col--left" role="list">{{ bullets_left }}</ul>
      <div class="c-features__media c-shoppable__media">
        {%- if s.image != blank -%}
          {%- if s.image.src contains '.gif' or s.image.src contains '.GIF' -%}{%- render 'c-gif', image: s.image, loading: 'lazy' -%}{%- else -%}{{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 40vw, 90vw' }}{%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'hotspot' -%}
            {%- assign b = block.settings -%}
            <div class="c-hotspot" style="left: {{ b.x }}%; top: {{ b.y }}%; --c-hx-mobile: {{ b.x }}%; --c-hy-mobile: {{ b.y }}%;" {{ block.shopify_attributes }}>
              <button type="button" class="c-hotspot__dot" aria-expanded="false" aria-label="{{ b.title | replace: '[produs]', c_product_name | escape }}"><span></span></button>
              <div class="c-hotspot__card color-{{ s.color_scheme }}" hidden>
                <span class="c-hotspot__info">
                  <span class="c-hotspot__title">{{ b.title | replace: '[produs]', c_product_name | escape }}</span>
                  {%- if b.text != blank -%}<span class="rte">{{ b.text | replace: '[produs]', c_product_name }}</span>{%- endif -%}
                </span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <ul class="c-features__col c-features__col--right" role="list">{{ bullets_right }}</ul>
    </shoppable-image>
    {%- render 'c-buttons', s: s -%}
  </div>
</div>

