{{ 'section-c-landing.css' | asset_url | stylesheet_tag }}
{{ 'carpatica-product.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carpatica-landing.js' | asset_url }}" defer="defer"></script>
{%- render 'c-section-style', section: section -%}
{%- assign s = section.settings -%}
<div class="c-columns-section color-{{ s.color_scheme }} gradient section-{{ section.id }}-padding" id="{{ s.anchor | default: section.id }}">
  <div class="page-width">
    {%- render 'c-section-header', section: section -%}
    <div class="c-columns c-columns--valign-{{ s.vertical_alignment }}{% if s.mobile_reverse %} c-columns--mobile-reverse{% endif %}" style="--c-cols: {{ s.columns }}; --c-col-gap: {{ s.gap }}px;">
      {%- for col in (1..s.columns) -%}
        <div class="c-columns__col{% if s.boxed_columns %} c-columns__col--boxed color-{{ s.box_color_scheme }}{% endif %}">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign bcol = b.column | plus: 0 -%}
            {%- if bcol > s.columns -%}{%- assign bcol = s.columns -%}{%- endif -%}
            {%- if bcol != col -%}{%- continue -%}{%- endif -%}
            <div class="c-col-block c-col-block--{{ block.type }} c-align-{{ b.alignment | default: 'left' }}" style="--c-mt: {{ b.margin_top | default: 0 }}px; --c-mb: {{ b.margin_bottom | default: 16 }}px;" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- if b.subheading != blank -%}<p class="c-subheading">{{ b.subheading | escape }}</p>{%- endif -%}
                  <h2 class="c-heading {{ b.heading_size }}">{{ b.heading }}</h2>
                {%- when 'richtext' -%}
                  <div class="rte">{{ b.text }}</div>
                {%- when 'rating_stars' -%}
                  {%- render 'c-stars', rating: b.rating, text: b.text, size: 18 -%}
                {%- when 'buttons' -%}
                  {%- render 'c-buttons', s: b -%}
                {%- when 'atc_button' -%}
                  {%- assign ap = b.product -%}
                  {%- if ap != blank -%}
                    {%- if ap.has_only_default_variant -%}
                      <button type="button" class="button{% if b.full_width %} button--full-width{% endif %}" data-quick-add="{{ ap.selected_or_first_available_variant.id }}"{% unless ap.available %} disabled{% endunless %}>
                        <span>{{ b.label | default: ap.title | escape }} · {{ ap.price | money }}</span>
                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- else -%}
                      <a href="{{ ap.url }}" class="button{% if b.full_width %} button--full-width{% endif %}">{{ b.label | default: ap.title | escape }}</a>
                    {%- endif -%}
                  {%- endif -%}
                {%- when 'text_with_icon' -%}
                  <div class="c-twi{% if b.boxed %} c-twi--boxed{% endif %}">
                    {%- render 'c-icon', name: b.icon, emoji: b.icon_emoji, image: b.icon_image, size: b.icon_size -%}
                    <div class="c-twi__text rte">{{ b.text }}</div>
                  </div>
                {%- when 'image' -%}
                  {%- if b.image != blank -%}
                    <div class="c-col-image" style="max-width: {{ b.width }}%; border-radius: {{ b.radius }}px;">
                      {%- if b.link != blank -%}<a href="{{ b.link }}">{%- endif -%}
                      {{ b.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
                      {%- if b.link != blank -%}</a>{%- endif -%}
                    </div>
                  {%- else -%}
                    <div class="c-col-image">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  {%- endif -%}
                {%- when 'video' -%}
                  <div class="c-pb-video" style="--c-video-radius: {{ b.radius }}px;">
                    {%- if b.video != blank -%}
                      {{ b.video | video_tag: autoplay: b.autoplay, loop: b.autoplay, muted: b.autoplay, controls: b.controls, playsinline: true, image_size: '1200x', class: 'c-pb-video__media' }}
                    {%- elsif b.video_url != blank -%}
                      {%- render 'c-video-embed', video_url: b.video_url, autoplay: b.autoplay -%}
                    {%- endif -%}
                  </div>
                {%- when 'accordion' -%}
                  <div class="accordion c-col-accordion">
                    <details{% if b.open %} open{% endif %}>
                      <summary>
                        <div class="summary__title">
                          {%- render 'c-icon', name: b.icon, size: 20 -%}
                          <h3 class="h4 accordion__title">{{ b.heading | escape }}</h3>
                        </div>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </summary>
                      <div class="accordion__content rte">{{ b.content }}</div>
                    </details>
                  </div>
                {%- when 'payment_badges' -%}
                  <ul class="list list-payment c-payments__list" role="list">
                    {%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}
                  </ul>
                {%- when 'email_signup' -%}
                  {%- form 'customer', id: 'ColumnsNewsletter', class: 'newsletter-form c-col-newsletter' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="newsletter-form__field-wrapper">
                      <div class="field">
                        <input id="ColumnsNewsletter-{{ block.id }}" type="email" name="contact[email]" class="field__input" autocomplete="email" placeholder="{{ 'newsletter.label' | t }}" required>
                        <label class="field__label" for="ColumnsNewsletter-{{ block.id }}">{{ 'newsletter.label' | t }}</label>
                        <button type="submit" class="newsletter-form__button field__button" aria-label="{{ 'newsletter.button_label' | t }}">{{- 'icon-arrow.svg' | inline_asset_content -}}</button>
                      </div>
                    </div>
                    {%- if form.posted_successfully? -%}<p class="c-text-savings">{{ 'newsletter.success' | t }}</p>{%- endif -%}
                  {%- endform -%}
                {%- when 'custom_liquid' -%}
                  {{ b.custom_liquid }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

