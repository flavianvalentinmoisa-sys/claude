    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cât durează livrarea?",
            "icon": "truck",
            "row_content": "<p>Comenzile plasate până la ora 14:00 pleacă în aceeași zi. Livrarea prin curier durează 24–48 de ore lucrătoare în toată țara.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Pot plăti la livrare (ramburs)?",
            "icon": "price_tag",
            "row_content": "<p>Da. Plătești curierului, numerar sau cu cardul, când primești coletul.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cum returnez un produs?",
            "icon": "return",
            "row_content": "<p>Ai 30 de zile pentru retur. Scrie-ne pe pagina de contact și îți trimitem instrucțiunile.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Produsele au garanție?",
            "icon": "check_mark",
            "row_content": "<p>Toate produsele au garanție 2 ani conform legislației în vigoare.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
