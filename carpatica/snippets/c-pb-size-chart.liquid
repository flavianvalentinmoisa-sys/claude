{% comment %}
  Bloc „Ghid mărimi”: link care deschide un pop-up cu tabelul de mărimi
  (din text formatat, dintr-o pagină sau dintr-o imagine).
  Parametri: block, product, section
{% endcomment %}
{%- assign bs = block.settings -%}
{%- assign modal_id = 'SizeChart-' | append: section.id | append: '-' | append: block.id -%}
<div class="c-size-chart c-block-spacing c-align-{{ bs.alignment }}" style="--c-mt: {{ bs.margin_top }}px; --c-mb: {{ bs.margin_bottom }}px;" {{ block.shopify_attributes }}>
  <button type="button" class="c-size-chart__opener link" data-modal-open="{{ modal_id }}" aria-haspopup="dialog">
    {%- render 'c-icon', name: bs.icon, size: 20 -%}
    <span>{%- if bs.label != blank -%}{{ bs.label | escape }}{%- else -%}{{ 'carpatica.product.size_chart' | t }}{%- endif -%}</span>
  </button>
</div>
<c-modal id="{{ modal_id }}" class="c-size-chart-modal" style="--c-modal-width: 72rem;" role="dialog" aria-modal="true" aria-label="{{ bs.heading | default: bs.label | escape }}">
  <div class="c-modal__overlay"></div>
  <div class="c-modal__dialog" tabindex="-1">
    <button type="button" class="c-modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t }}">{{- 'icon-close.svg' | inline_asset_content -}}</button>
    <div class="c-modal__body">
      {%- if bs.heading != blank -%}<p class="h3 c-size-chart__title">{{ bs.heading }}</p>{%- endif -%}
      {%- if bs.image != blank -%}
        <div class="c-size-chart__image">{%- if bs.image.src contains '.gif' or bs.image.src contains '.GIF' -%}{%- render 'c-gif', image: bs.image, loading: 'lazy' -%}{%- else -%}{{ bs.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 720px, 100vw' }}{%- endif -%}</div>
      {%- endif -%}
      <div class="rte c-size-chart__content">
        {{ bs.content }}
        {{ bs.page.content }}
      </div>
    </div>
  </div>
</c-modal>
