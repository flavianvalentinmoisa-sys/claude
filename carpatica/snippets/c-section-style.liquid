{% comment %}
  Spațierea standard a unei secțiuni Carpatica (75% pe mobil) și vizibilitatea pe dispozitive.
  Parametri: section
{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.visibility == 'desktop' %}
    @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} { display: none; } }
  {%- elsif section.settings.visibility == 'mobile' %}
    @media screen and (min-width: 750px) { #shopify-section-{{ section.id }} { display: none; } }
  {%- endif %}
{%- endstyle -%}
