{% comment %}
  Iconițe Carpatica (SVG, stil linie, 24x24, culoare moștenită)

  Parametri:
  - name: numele iconiței (vezi lista din snippets/c-icon-options.liquid)
  - image: imagine personalizată (opțional, înlocuiește iconița)
  - emoji: text/emoji (opțional, înlocuiește iconița)
  - size: mărime în px (opțional)
  - color: culoare (opțional)
  - filled: true pentru varianta plină (stea, inimă)

  Utilizare:
  {% render 'c-icon', name: 'truck', size: 22 %}
{% endcomment %}
{%- liquid
  assign style = ''
  if size
    assign style = style | append: '--c-icon-size:' | append: size | append: 'px;'
  endif
  if color != blank
    assign style = style | append: '--c-icon-color:' | append: color | append: ';'
  endif
-%}
{%- if image != blank -%}
  <span class="c-icon" style="{{ style }}" aria-hidden="true">
    {{- image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' -}}
  </span>
{%- elsif emoji != blank -%}
  <span class="c-icon c-emoji" style="{{ style }}" aria-hidden="true">{{ emoji }}</span>
{%- elsif name != blank and name != 'none' -%}
  {%- capture fill -%}{% if filled %}currentColor{% else %}none{% endif %}{%- endcapture -%}
  <span class="c-icon c-icon--{{ name }}" style="{{ style }}" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      {%- case name -%}
        {%- when 'check' -%}
          <path d="M4.5 12.5l5 5L19.5 7"/>
        {%- when 'check_circle' -%}
          <circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.8 2.8L16.2 9.5"/>
        {%- when 'truck' -%}
          <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
        {%- when 'truck_fast' -%}
          <path d="M5 6.5h9v9H8"/><path d="M14 9.5h3.5l3 3.2v2.8H14"/><circle cx="9.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/><path d="M2 9h4M1.5 12h4.5"/>
        {%- when 'package' -%}
          <path d="M12 2.8l8.5 4.6v9.2L12 21.2l-8.5-4.6V7.4z"/><path d="M3.5 7.4L12 12l8.5-4.6M12 12v9.2"/><path d="M7.8 5.1l8.4 4.6"/>
        {%- when 'return' -%}
          <path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/>
        {%- when 'shield' -%}
          <path d="M12 2.8l7.5 3v5.7c0 4.6-3.2 8.3-7.5 9.7-4.3-1.4-7.5-5.1-7.5-9.7V5.8z"/><path d="M8.8 12l2.3 2.3 4.2-4.6"/>
        {%- when 'lock' -%}
          <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/><path d="M12 14.5v2.5"/>
        {%- when 'card' -%}
          <rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 9.5h19M6.5 15h3"/>
        {%- when 'cash' -%}
          <rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/>
        {%- when 'wallet' -%}
          <path d="M19.5 7.5V6a2 2 0 00-2-2h-12a2 2 0 00-2 2v12a2 2 0 002 2h14a1 1 0 001-1v-3.5"/><path d="M20.5 10h-5a2 2 0 000 4h5z"/>
        {%- when 'star' -%}
          <path fill="{{ fill }}" d="M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/>
        {%- when 'heart' -%}
          <path fill="{{ fill }}" d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0112 7.2a4.3 4.3 0 017.5 2.6C19.5 15.4 12 20 12 20z"/>
        {%- when 'gift' -%}
          <rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5v8h14v-8M12 8.5v12"/><path d="M12 8.5S11 4 8.3 4.5C6.4 4.9 6.8 8.5 12 8.5zM12 8.5s1-4.5 3.7-4C17.6 4.9 17.2 8.5 12 8.5z"/>
        {%- when 'fire' -%}
          <path d="M12 21c-3.9 0-6.5-2.6-6.5-6.2 0-3.7 3-5.7 3.6-9.3 1.9 1.1 2.9 3 2.9 4.6 1-.6 1.7-1.8 1.8-3.1 2.7 2 4.7 4.8 4.7 7.8 0 3.6-2.6 6.2-6.5 6.2z"/><path d="M12 21c-1.6 0-2.7-1.1-2.7-2.6 0-1.7 1.6-2.5 2.7-4.2 1.1 1.7 2.7 2.5 2.7 4.2 0 1.5-1.1 2.6-2.7 2.6z"/>
        {%- when 'clock' -%}
          <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>
        {%- when 'calendar' -%}
          <rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
        {%- when 'phone' -%}
          <path d="M5 3.5h3.5l1.7 4.3-2.2 1.4a11 11 0 005.8 5.8l1.4-2.2 4.3 1.7V18a2.5 2.5 0 01-2.5 2.5A15.5 15.5 0 012.5 6 2.5 2.5 0 015 3.5z"/>
        {%- when 'chat' -%}
          <path d="M4 5.5h16a1 1 0 011 1V16a1 1 0 01-1 1h-9.5L6 20.5V17H4a1 1 0 01-1-1V6.5a1 1 0 011-1z"/><path d="M7.5 10h9M7.5 13h6"/>
        {%- when 'email' -%}
          <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>
        {%- when 'map_pin' -%}
          <path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
        {%- when 'leaf' -%}
          <path d="M5 19c0-8.5 5.5-14 15-14 0 9.5-5.5 15-14 15"/><path d="M5 19c3-4.5 6-7 10-9"/>
        {%- when 'recycle' -%}
          <path d="M7.5 9.5L5 14a2 2 0 001.7 3H11"/><path d="M14 17h3.3a2 2 0 001.7-3l-1.6-2.8"/><path d="M9.2 6.2l1.1-1.9a2 2 0 013.4 0l1.8 3.2"/><path d="M13 17l-2 -2.2M13 17l-2 2"/><path d="M15.6 7.5l.3-2.9M15.6 7.5l-2.8-.6"/><path d="M7.5 9.5l-2.7.9M7.5 9.5l.6 2.8"/>
        {%- when 'sparkle' -%}
          <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 16l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/>
        {%- when 'thumbs_up' -%}
          <path d="M7.5 10.5V20H4.5a1 1 0 01-1-1v-7.5a1 1 0 011-1z"/><path d="M7.5 10.5l3.6-6.6a1.8 1.8 0 013.3 1.3l-.9 4.3h5.2a2 2 0 012 2.3l-1.2 6.6a2.4 2.4 0 01-2.4 1.6H7.5"/>
        {%- when 'users' -%}
          <circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M15.5 4.8a3.5 3.5 0 010 6.4M18 14.5c2.2.6 3.5 2.6 3.5 5.5"/>
        {%- when 'award' -%}
          <circle cx="12" cy="9" r="6"/><path d="M8.5 13.8L7 21l5-2.6 5 2.6-1.5-7.2"/><path d="M12 6.3l.9 1.8 2 .3-1.4 1.4.3 2-1.8-1-1.8 1 .3-2-1.4-1.4 2-.3z"/>
        {%- when 'percent' -%}
          <path d="M18.5 5.5l-13 13"/><circle cx="7" cy="7" r="2.3"/><circle cx="17" cy="17" r="2.3"/>
        {%- when 'tag' -%}
          <path d="M3.5 12.3V4.5a1 1 0 011-1h7.8l8.7 8.7a1.5 1.5 0 010 2.1l-6.4 6.4a1.5 1.5 0 01-2.1 0z"/><circle cx="8" cy="8" r="1.5"/>
        {%- when 'eye' -%}
          <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
        {%- when 'lightning' -%}
          <path d="M13 2.5L4.5 13.5H12l-1 8 8.5-11H12z"/>
        {%- when 'globe' -%}
          <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z"/>
        {%- when 'smile' -%}
          <circle cx="12" cy="12" r="9"/><path d="M8.3 14.2a4.5 4.5 0 007.4 0"/><path d="M9 9.5h.01M15 9.5h.01" stroke-width="2.6"/>
        {%- when 'info' -%}
          <circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8h.01" stroke-width="2.2"/>
        {%- when 'warning' -%}
          <path d="M12 3.5L2.5 20h19z"/><path d="M12 10v4.5M12 17.2h.01" stroke-width="2.2"/>
        {%- when 'question' -%}
          <circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 015 .9c0 1.8-2.5 2.2-2.5 3.8M12 17.2h.01"/>
        {%- when 'ruler' -%}
          <rect x="2.5" y="8" width="19" height="8" rx="1.2"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/>
        {%- when 'box_open' -%}
          <path d="M3.5 9.5L12 13l8.5-3.5M12 13v8"/><path d="M3.5 9.5v7.2L12 21l8.5-4.3V9.5L12 6z"/><path d="M3.5 9.5L1.5 6.5 9.8 3 12 6M20.5 9.5l2-3L14.2 3 12 6"/>
        {%- when 'plane' -%}
          <path d="M21 4.5l-7.5 16-3-7-7-3z"/><path d="M10.5 13.5L21 4.5"/>
        {%- when 'support' -%}
          <path d="M4.5 13.5v-1.5a7.5 7.5 0 0115 0v1.5"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.4-1.6 2-4 2h-2"/>
        {%- when 'medal' -%}
          <path d="M8 3h8l-2.5 6h-3z"/><circle cx="12" cy="15" r="5.5"/><path d="M12 12.5v5M10.5 13.8L12 12.5"/>
        {%- when 'bolt_battery' -%}
          <rect x="2.5" y="7" width="17" height="10" rx="2"/><path d="M21.5 10.5v3M11.5 8.5L8.5 12.5h4l-2 3"/>
        {%- when 'water' -%}
          <path d="M12 3s6.5 7 6.5 11.5a6.5 6.5 0 01-13 0C5.5 10 12 3 12 3z"/><path d="M9 15a3 3 0 003 3"/>
        {%- when 'sun' -%}
          <circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6L6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/>
        {%- when 'moon' -%}
          <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/>
        {%- when 'baby' -%}
          <circle cx="12" cy="12" r="9"/><path d="M9 10.5h.01M15 10.5h.01" stroke-width="2.4"/><path d="M9.8 14.5a3 3 0 004.4 0"/><path d="M12 3c-1 1.3-1 2.7.5 3.5"/>
        {%- when 'paw' -%}
          <circle cx="7" cy="10" r="1.8"/><circle cx="10.2" cy="6.2" r="1.8"/><circle cx="13.8" cy="6.2" r="1.8"/><circle cx="17" cy="10" r="1.8"/><path d="M12 11.5c-2.8 0-5 3.3-5 5.5 0 1.6 1.2 2.5 2.6 2.5 1 0 1.5-.5 2.4-.5s1.4.5 2.4.5c1.4 0 2.6-.9 2.6-2.5 0-2.2-2.2-5.5-5-5.5z"/>
        {%- when 'dumbbell' -%}
          <path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/>
        {%- when 'home' -%}
          <path d="M3.5 11L12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>
        {%- when 'arrow_right' -%}
          <path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'plus' -%}
          <path d="M12 5v14M5 12h14"/>
        {%- when 'minus' -%}
          <path d="M5 12h14"/>
        {%- when 'close' -%}
          <path d="M6 6l12 12M18 6L6 18"/>
        {%- when 'flag' -%}
          <path d="M5 21V4M5 4.5h11.5l-2 4 2 4H5"/>
        {%- when 'romania' -%}
          <rect x="2.5" y="5.5" width="19" height="13" rx="1.5"/><path d="M8.8 5.5v13M15.2 5.5v13"/>
        {%- else -%}
          <circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.8 2.8L16.2 9.5"/>
      {%- endcase -%}
    </svg>
  </span>
{%- endif -%}
